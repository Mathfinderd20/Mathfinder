# Public browser configuration. These values are safe to expose, but never put
# the Supabase service-role key in a VITE_* variable.
VITE_APP_ENV=development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local defaults after `npm run supabase:start`:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<the publishable key from `npx supabase status`>
